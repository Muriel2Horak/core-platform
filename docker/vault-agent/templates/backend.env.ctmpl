{{- with secret "kv/data/core/postgres" -}}
DATABASE_PASSWORD={{ .Data.data.password }}
{{- end -}}
{{- with secret "kv/data/core/keycloak-db" -}}
KEYCLOAK_DB_PASSWORD={{ .Data.data.password }}
{{- end -}}
{{- with secret "kv/data/core/keycloak" -}}
KEYCLOAK_ADMIN_PASSWORD={{ .Data.data.admin_password }}
KEYCLOAK_ADMIN_CLIENT_SECRET={{ .Data.data.admin_client_secret }}
KEYCLOAK_CLIENT_SECRET={{ .Data.data.client_secret }}
{{- end -}}
{{- with secret "kv/data/core/grafana" -}}
GRAFANA_JWT_SECRET={{ .Data.data.jwt_secret }}
{{- end -}}
{{- with secret "kv/data/core/redis" -}}
REDIS_PASSWORD={{ .Data.data.password }}
{{- end -}}
